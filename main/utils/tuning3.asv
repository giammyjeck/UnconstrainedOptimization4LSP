
%% ============================================================
%% PARAMETER TUNING FOR MODIFIED NEWTON METHOD
%% with conditional c1 fallback (c1_small -> c1_large only on btmax-near failure)
%% ============================================================
clear; clc; close all;
addpath(genpath(pwd));

rng(346710);

[f, gradf, hessf, xbar_gen] = problem_broyden31();

%% ---------------- Parameters ----------------
tolgrad = 1e-6;        % experimenter choice (not tuned)
c1_small = 1e-4;       % default Armijo (tried first)
c1_large = 1e-3;       % fallback tried ONLY if btmax + grad near

% Dimensions
n_ref1 = 1e3;
n_ref2 = [1e3, 1e4];

% Regularization: tune beta (not gamma)
beta_grid = [1e-3, 1e-2, 1e-1, 1];

% Backtracking
rho_grid   = [0.3, 0.5, 0.8];

% Outer iteration budgets
kmax_grid  = [550, 1000, 2000];

% btmax sampling control (rho-dependent)
alpha_min     = 1e-8;   % minimal admissible step (rho^btmax >= alpha_min)
btmax_min     = 3;      % avoid trivial backtracking
n_bt_samples  = 4;      % number of btmax samples per rho

% diagnostic threshold for "near stationarity" when btmax reached
kappa_grad = 10;        % consider "near" if gnorm <= kappa_grad * tolgrad

%% ---------------- Generate configurations (rho–btmax linked) ----------------
cfg_id = 0;
configs = struct();

for beta = beta_grid
    for rho = rho_grid
        if rho <= 0 || rho >= 1
            continue;
        end
        btmax_bound = floor(log(alpha_min) / log(rho));
        if btmax_bound < btmax_min
            continue;
        end
        if btmax_bound == btmax_min
            btmax_grid_rho = btmax_min;
        else
            btmax_grid_rho = unique(round( ...
                linspace(btmax_min, btmax_bound, ...
                min(n_bt_samples, btmax_bound - btmax_min + 1))));
        end

        for btmax = btmax_grid_rho
            for kmax = kmax_grid
                cfg_id = cfg_id + 1;
                configs(cfg_id).beta  = beta;
                configs(cfg_id).rho   = rho;
                configs(cfg_id).btmax = btmax;
                configs(cfg_id).kmax  = kmax;
                configs(cfg_id).c1    = NaN;      % unset yet
                configs(cfg_id).alive = true;
            end
        end
    end
end

fprintf('Total configurations (rho–btmax consistent): %d\n', numel(configs));

%% ---------------- REF1: cheap test on n_ref1 with conditional c1 fallback ----------------
fprintf('\n=== REFINEMENT 1 (n = %d) ===\n', n_ref1);
n_starts_1 = 5;
dead_ref1 = 0;

for i = 1:numel(configs)
    if ~configs(i).alive
        continue;
    end

    beta  = configs(i).beta;
    rho   = configs(i).rho;
    btmax = configs(i).btmax;
    kmax  = configs(i).kmax;

    % generate starting points (cheap)
    x0_base = xbar_gen(n_ref1);
    x0_rand = (x0_base-1) + 2*rand(n_ref1, n_starts_1-1);
    all_x0  = [x0_base, x0_rand];

    % ---------- TRY WITH c1_small ----------
    c1_try = c1_small;
    success = true;
    fail_type = '';
    k_used_on_success = [];

    for s = 1:size(all_x0,2)
        [~, ~, gnorm, k, ~, btseq] = modified_newton_method( ...
            all_x0(:,s), f, gradf, hessf, ...
            kmax, tolgrad, c1_try, rho, btmax, beta);

        bt_reached = (~isempty(btseq) && btseq(end) >= btmax);

        if gnorm > tolgrad
            success = false;
            if bt_reached
                % Distinguish near vs far from tolgrad
                if gnorm <= kappa_grad*tolgrad
                    fail_type = 'btmax_grad_near';
                else
                    fail_type = 'btmax_grad_far';
                end
            else
                fail_type = 'grad_not_converged';
            end
            break;
        end

        if k >= kmax
            success = false;
            fail_type = 'kmax_reached';
            break;
        end

        % save k used in case we want to prune larger kmax later
        k_used_on_success = k;
    end

    % if btmax+near failure, retry with c1_large
    if ~success && strcmp(fail_type,'btmax_grad_near')
        % second try with larger (more permissive) c1
        c1_try = c1_large;
        success2 = true;
        fail_type2 = '';
        k_used_on_success2 = [];

        for s = 1:size(all_x0,2)
            [~, ~, gnorm, k, ~, btseq] = modified_newton_method( ...
                all_x0(:,s), f, gradf, hessf, ...
                kmax, tolgrad, c1_try, rho, btmax, beta);

            bt_reached = (~isempty(btseq) && btseq(end) >= btmax);

            if gnorm > tolgrad
                success2 = false;
                if bt_reached
                    if gnorm <= kappa_grad*tolgrad
                        fail_type2 = 'btmax_grad_near';
                    else
                        fail_type2 = 'btmax_grad_far';
                    end
                else
                    fail_type2 = 'grad_not_converged';
                end
                break;
            end

            if k >= kmax
                success2 = false;
                fail_type2 = 'kmax_reached';
                break;
            end

            k_used_on_success2 = k;
        end

        if success2
            success = true;
            fail_type = '';           % overwritten by success
            configs(i).c1 = c1_try;   % record used c1
            if ~isempty(k_used_on_success2)
                k_used_on_success = k_used_on_success2;
            end
        else
            % failed also with c1_large -> treat as structural fail (use fail_type2)
            success = false;
            fail_type = fail_type2;
        end
    else
        if success
            configs(i).c1 = c1_try;   % record used c1_small
        end
    end

    % ---------- act on outcome ----------
    if success
        fprintf(' kept: beta=%g rho=%g btmax=%d kmax=%d (c1=%.0e)\n', ...
            beta, rho, btmax, kmax, configs(i).c1);

        % PRUNE: if this config converged using k_used_on_success (<= kmax),
        % then any sibling with same beta,rho,btmax and larger kmax is redundant:
        if ~isempty(k_used_on_success)
            for j = 1:numel(configs)
                if ~configs(j).alive || j==i
                    continue;
                end
                if configs(j).beta==beta && configs(j).rho==rho && configs(j).btmax==btmax && configs(j).kmax>k_used_on_success
                    % mark as redundant (we consider it kept via pruning)
                    configs(j).alive = false;
                    dead_ref1 = dead_ref1 + 1;
                end
            end
        end

    else
        % discard this configuration
        configs(i).alive = false;
        dead_ref1 = dead_ref1 + 1;
        fprintf(' discarded: beta=%g rho=%g btmax=%d kmax=%d | %s (c1 tried=%.0e)\n', ...
            beta, rho, btmax, kmax, fail_type, c1_try);

        % PRUNING RULES based on fail_type
        for j = 1:numel(configs)
            if ~configs(j).alive
                continue;
            end
            if configs(j).beta==beta && configs(j).rho==rho
                % If kmax insufficient, smaller kmax are worse -> prune them
                if strcmp(fail_type,'kmax_reached') && configs(j).kmax < kmax
                    configs(j).alive = false;
                    dead_ref1 = dead_ref1 + 1;
                end
                % If btmax structural failure (far), smaller/equal btmax are worse
                if strcmp(fail_type,'btmax_grad_far') && configs(j).btmax <= btmax
                    configs(j).alive = false;
                    dead_ref1 = dead_ref1 + 1;
                end
            end
        end
    end
end

fprintf('Refinement 1: discarded configurations: %d / %d\n', dead_ref1, numel(configs));

%% ---------------- REF2: robustness across dimensions (n_ref2) ----------------
fprintf('\n=== REFINEMENT 2 (n = %g, %g) ===\n', n_ref2(1), n_ref2(2));
w_t = 1;   % time
w_g = 10;  % penalty for not reaching tol
refined = struct();
rid = 0;
dead_ref2 = 0;

for i = 1:numel(configs)
    if ~configs(i).alive
        continue;
    end

    beta  = configs(i).beta;
    rho   = configs(i).rho;
    btmax = configs(i).btmax;
    kmax  = configs(i).kmax;
    c1    = configs(i).c1;
    if isnan(c1)
        % if never set (e.g. pruned sibling), use default small c1
        c1 = c1_small;
    end

    success = true;
    L_cfg = -Inf;

    for n = n_ref2
        gamma = beta / n;

        % generate few starting points (more thorough than ref1)
        x0_base = xbar_gen(n);
        x0_rand = (x0_base-1) + 2*rand(n, 10);
        all_x0  = [x0_base, x0_rand];

        for s = 1:size(all_x0,2)
            tic;
            [~, ~, gnorm, k, ~, btseq] = modified_newton_method( ...
                all_x0(:,s), f, gradf, hessf, ...
                kmax, tolgrad, c1, rho, btmax, gamma*n);
            t_run = toc;

            bt_reached = (~isempty(btseq) && btseq(end) >= btmax);

            if gnorm > tolgrad || k >= kmax || bt_reached
                success = false;
                dead_ref2 = dead_ref2 + 1;
                break;
            end

            phi = max(0, log10(gnorm / tolgrad));
            L_run = w_t*t_run + w_g*phi;
            L_cfg = max(L_cfg, L_run);
        end

        if ~success
            break;
        end
    end

    if success
        rid = rid + 1;
        refined(rid).beta  = beta;
        refined(rid).rho   = rho;
        refined(rid).btmax = btmax;
        refined(rid).kmax  = kmax;
        refined(rid).c1    = c1;
        refined(rid).loss  = L_cfg;
        fprintf(' kept: beta=%g rho=%g btmax=%d kmax=%d | loss=%.3e (c1=%.0e)\n', ...
            beta, rho, btmax, kmax, L_cfg, c1);
    else
        fprintf(' discarded in REF2: beta=%g rho=%g btmax=%d kmax=%d\n', beta, rho, btmax, kmax);
    end
end

fprintf('Refinement 2: discarded configurations: %d\n', dead_ref2);

%% ---------------- FINAL REFINEMENT & VISUALIZATION ----------------
if isempty(refined)
    error('No configurations survived refinement 2.');
end

losses = [refined.loss];
thr = prctile(losses,10);
best = refined(losses <= thr);

beta_vals  = [best.beta];
rho_vals   = [best.rho];
btmax_vals = [best.btmax];
kmax_vals  = [best.kmax];
c1_vals    = [best.c1];
loss_vals  = [best.loss];

% rho vs btmax
figure; scatter(btmax_vals, rho_vals, 80, log10(loss_vals), 'filled'); colorbar;
xlabel('btmax'); ylabel('\rho'); title('Best configs: \rho vs btmax (log_{10} loss)'); grid on;

% beta vs btmax
figure; scatter(btmax_vals, beta_vals, 80, log10(loss_vals), 'filled'); colorbar;
xlabel('btmax'); ylabel('\beta'); title('Best configs: \beta vs btmax (log_{10} loss)'); grid on;

% beta vs rho
figure; scatter(rho_vals, beta_vals, 80, log10(loss_vals), 'filled'); colorbar;
xlabel('\rho'); ylabel('\beta'); title('Best configs: \beta vs \rho (log_{10} loss)'); grid on;

% c1 vs btmax
figure; scatter(btmax_vals, c1_vals, 80, log10(loss_vals), 'filled'); colorbar;
xlabel('btmax'); ylabel('c1'); title('Best configs: c1 vs btmax (log_{10} loss)'); grid on;

% Top 3
[~, idx_best] = sort(loss_vals);
topN = min(3, numel(best));
topk = best(idx_best(1:topN));

disp('Top configurations (lowest loss):');
for t = 1:topN
    fprintf('Beta=%.3g, rho=%.2g, btmax=%d, kmax=%d, c1=%.0e, loss=%.4e\n', ...
        topk(t).beta, topk(t).rho, topk(t).btmax, topk(t).kmax, topk(t).c1, topk(t).loss);
end

fprintf('\nSummary:\n  total configs: %d\n  discarded ref1: %d\n  discarded ref2: %d\n  survived to final: %d\n', ...
    numel(configs), dead_ref1, dead_ref2, numel(best));
